# Copy to .env (git-ignored) and fill in. Read by BOTH docker compose and Spring Boot
# (application.properties imports .env via spring.config.import).

# --- docker compose: MySQL container ---
# Keep MYSQL_DATABASE=ecommerce_db unless you also change db/schema.sql (it hard-codes the name).
MYSQL_DATABASE=ecommerce_db
MYSQL_ROOT_PASSWORD=change-me

# --- Spring Boot when run on the host with ./mvnw spring-boot:run ---
# Default targets the compose MySQL on host port 3307. For a MySQL on the host's own 3306,
# change the port and password.
DB_URL=jdbc:mysql://localhost:3307/ecommerce_db
DB_USER=root
DB_PASSWORD=change-me
